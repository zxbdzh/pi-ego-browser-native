{
  "name": "pi-ego-browser-native",
  "version": "0.1.0",
  "description": "Run Ego Browser scripts as a native Pi tool with inline screenshots and persistent TaskSpaces.",
  "type": "module",
  "license": "MIT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zxbdzh/pi-ego-browser-native.git"
  },
